# Copia este archivo como ".env" y cambia los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# ===================== RabbitMQ (docker-compose.cluster.yml) =====================

# Cookie de Erlang: debe ser IGUAL en ambos nodos. Usa algo largo y aleatorio.
RABBITMQ_ERLANG_COOKIE=cambia-este-valor-por-uno-largo-y-aleatorio

# Usuario propio del clúster (en cloud no se deja guest/guest con la UI abierta).
RABBITMQ_USER=admin_pedidos
RABBITMQ_PASS=cambia-esta-clave

# ===================== Kafka (docker-compose.kafka.yml) =====================

# Dirección con la que el backend alcanza los brokers (listener EXTERNAL).
#   Local (Docker Desktop):  localhost
#   AWS: IP PRIVADA de la EC2 donde corre Kafka (el backend va en otra EC2
#        de la misma VPC), p. ej. 172.31.x.x
# Si no se define, el compose usa localhost.
KAFKA_EXTERNAL_HOST=localhost

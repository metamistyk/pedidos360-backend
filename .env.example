# Copia este archivo como ".env" y cambia los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Cookie de Erlang: debe ser IGUAL en ambos nodos. Usa algo largo y aleatorio.
RABBITMQ_ERLANG_COOKIE=cambia-este-valor-por-uno-largo-y-aleatorio

# Usuario propio del clúster (en cloud no se deja guest/guest con la UI abierta).
RABBITMQ_USER=admin_pedidos
RABBITMQ_PASS=cambia-esta-clave
